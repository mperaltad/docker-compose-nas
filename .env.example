COMPOSE_PROFILES=
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:calibre/docker-compose.yml:monitoring/docker-compose.yml
USER_ID=1000
GROUP_ID=1000
TIMEZONE="Europe/Madrid"
CONFIG_ROOT="$HOME/docker-compose-nas-volume/config"
DATA_ROOT="$HOME/docker-compose-nas-volume/data"
NAS_MEDIA_ROOT="/mnt/nas"
GDRIVE_ID=your_client_id_here.apps.googleusercontent.com
GDRIVE_SECRET=your_client_secret_here
GDRIVE_ROOT=FOLDER_ID_IN_DRIVE
# Full JSON block from 'rclone authorize'
GDRIVE_TOKEN={"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}

# VPN and Zero Trust Configurations
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
VPN_DOMAIN=vpn.yourdomain.com
# Pre-auth key from Headscale VPS (read from VPS provider's cloud-init console after terraform apply)
TS_AUTHKEY=your_headscale_preauth_key_here

# Nextcloud Database Secrets
NEXTCLOUD_DB_HOST=nextcloud_db
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_ROOT_PASSWORD=your_secure_root_password
NEXTCLOUD_DB_PASSWORD=your_secure_nextcloud_password

